{
  "name": "pillow-control",
  "version": "0.1.0",
  "description": "枕控 PillowControl — Windows 局域网遥控器",
  "author": "PillowControl contributors",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build": "npm run native && node scripts/build.mjs",
    "dev": "npm run build && node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "pack:dir": "npm run build && electron-builder --win dir --x64",
    "pack": "npm run build && electron-builder --win portable nsis --x64",
    "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-verification.ps1 && node scripts/verify-windows.mjs"
  },
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.0.18",
    "vue": "3.5.42",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "appId": "org.pillowcontrol.desktop",
    "productName": "枕控 PillowControl",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "pillow-control-${version}-portable-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "pillow-control-${version}-setup-${arch}.exe"
    }
  }
}
