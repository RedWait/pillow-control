{
  "name": "pillow-control",
  "version": "0.2.1",
  "description": "枕控 PillowControl — Windows 局域网遥控器",
  "author": "PillowControl contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "start": "node scripts/run-app.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:rust": "node scripts/cargo.mjs test --locked --lib --tests",
    "check:rust": "node scripts/cargo.mjs check --locked",
    "build:frontend": "node scripts/build-frontend.mjs && node scripts/licenses.mjs",
    "build": "node scripts/tauri.mjs build --no-bundle",
    "pack": "node scripts/tauri.mjs build && node scripts/package-portable.mjs",
    "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-verification.ps1 && node scripts/verify-tauri.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:mobile": "npm run build:frontend && node scripts/verify-mobile-ui.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.45.0",
    "@tauri-apps/api": "2.11.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.9",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.0.18",
    "vue": "3.5.42",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
