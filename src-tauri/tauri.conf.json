{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "枕控 PillowControl",
  "version": "0.2.1",
  "identifier": "org.pillowcontrol.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-frontend.mjs && node scripts/licenses.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs && node scripts/licenses.mjs",
    "frontendDist": "../tauri-dist/desktop-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "枕控 PillowControl",
        "width": 760,
        "height": 680,
        "minWidth": 480,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "desktop"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "手机浏览器遥控 Windows 电脑",
    "copyright": "Copyright 2026 PillowControl contributors",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "zlib",
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/installer.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "resources": {
      "../tauri-dist/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../LICENSE": "LICENSE",
      "../README.md": "README.md",
      "../docs/ACCEPTANCE.md": "docs/ACCEPTANCE.md",
      "../docs/VALIDATION.md": "docs/VALIDATION.md",
      "../docs/MIGRATION.md": "docs/MIGRATION.md",
      "../docs/SECURITY.md": "docs/SECURITY.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/MOBILE_UI.md": "docs/MOBILE_UI.md",
      "../docs/AUTOCONNECT.md": "docs/AUTOCONNECT.md",
      "../README.en.md": "README.en.md",
      "../CONTRIBUTING.md": "CONTRIBUTING.md",
      "../docs/DEVELOPMENT.md": "docs/DEVELOPMENT.md",
      "../docs/TROUBLESHOOTING.md": "docs/TROUBLESHOOTING.md",
      "../docs/UI_POLISH.md": "docs/UI_POLISH.md",
      "../docs/assets/": "docs/assets/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
